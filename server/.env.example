# Scope C — Supabase. The server verifies Supabase JWTs and uses the service
# role for the relay's access checks. (Prisma/SQLite is retired in scope C.)
PORT=4000
COLLAB_PORT=4001
CLIENT_ORIGIN="http://localhost:5173"

# Supabase (Project → Settings → API)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # SECRET — server only
SUPABASE_JWT_SECRET="your-jwt-secret"               # Settings → API → JWT Secret

# LevelDB dir for the Yjs relay (unchanged)
YJS_DB_DIR="./y-leveldb"
