# Scope C — Supabase. The server verifies Supabase JWTs (via JWKS) and uses the
# service-role key for the relay's access checks. (Prisma/SQLite is retired.)
PORT=4000
COLLAB_PORT=4001
CLIENT_ORIGIN="http://localhost:5173"

# Supabase (Project → Settings). New-style keys (sb_publishable_ / sb_secret_).
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."          # SECRET — server only
# Asymmetric JWT signing → verify via the project's public JWKS (no secret):
SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"

# LevelDB dir for the Yjs relay
YJS_DB_DIR="./y-leveldb"

# NOTE: for local testing, disable email confirmation in
# Supabase → Authentication → Providers → Email, so signup returns a session.
