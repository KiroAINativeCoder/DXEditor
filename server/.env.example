# Copy to .env and adjust. SQLite for dev:
DATABASE_URL="file:./dev.db"
PORT=4000
COLLAB_PORT=4001

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
# The web client origin, for CORS with credentials (cookies)
CLIENT_ORIGIN="http://localhost:5173"

# For Postgres, set schema.prisma provider="postgresql" and use e.g.:
# DATABASE_URL="postgresql://user:pass@localhost:5432/dxeditor?schema=public"
